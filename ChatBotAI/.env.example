# ChatBotAI Environment Configuration Example
# Copy this to .env and modify as needed

# Flask Configuration
FLASK_ENV=development
# Generate a private random key before production startup. Never commit it.
SECRET_KEY=change-this-to-a-secure-random-string

# Database
# Omit DATABASE_URL to use ChatBotAI/instance/chatbot.db (recommended).
# Use an absolute SQLite path if overriding it.

# Ollama AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_TIMEOUT=90

# Only enable behind a trusted reverse proxy. Forwarded host/prefix are not trusted.
CHATBOT_TRUST_PROXY_HEADERS=false

# AI Behavior
AI_AUTO_RESPONSE_ENABLED=true
AI_MEMORY_EXTRACTION_ENABLED=true
AI_RESPONSE_TONE=friendly_professional
MAX_CONVERSATION_HISTORY=10

# Gmail Integration
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Set this to your exact callback URL to avoid redirect_uri_mismatch errors
# Must match what's configured in Google Cloud Console > Authorized redirect URIs
# GMAIL_REDIRECT_URI=http://localhost/chatbot/gmail/callback

# WhatsApp Integration — local Baileys bridge (whatsapp_bridge/)
# UNOFFICIAL CLIENT: violates WhatsApp's ToS, the number can be banned.
# Leave WHATSAPP_BRIDGE_URL empty to keep the integration off entirely.
# The secret is mandatory when the bridge is used: the webhook is reachable
# without a login, so an unset secret makes it reject everything.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Airbnb Integration (future)
AIRBNB_API_URL=
AIRBNB_API_TOKEN=

# Booking.com Integration (future)
BOOKING_API_URL=
BOOKING_API_TOKEN=
